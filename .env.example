DISCORD_TOKEN=
GUILD_ID=
MAX_PRICE_YEN=
CHECK_INTERVAL_SECONDS=90

# ZenMarket Cloudflare bypass cookies (copy from browser DevTools → Application → Cookies)
# If ZENMARKET_CF_CLEARANCE is set, the scraper uses ZenMarket via curl-cffi.
# Leave blank to scrape jp.mercari.com directly (no Cloudflare protection needed).
ZENMARKET_CF_CLEARANCE=
ZENMARKET_SESSION_ID=
ZENMARKET_AUTH=
ZENMARKET_ARR=
